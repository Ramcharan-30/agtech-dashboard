# ─── Backend Environment Variables ───
# Copy this to .env for local development
# Set these in Vercel Dashboard → backend project → Settings → Environment Variables

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret — generate with: node -e "require('crypto').randomBytes(64).toString('hex')"
JWT_SECRET=

# Google OAuth Client ID (from Google Cloud Console → Credentials)
# Must match VITE_GOOGLE_CLIENT_ID in the frontend Vercel project
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com

# Deployed frontend URL (used for CORS allowlist)
# Production: https://<your-frontend>.vercel.app
# Local dev:  http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Local server port (Vercel ignores this — serverless has no port)
PORT=5000
